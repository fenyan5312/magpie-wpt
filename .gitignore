node_modules/
*.log

# Credentials must never be committed. The tool reads them from the clipboard
# or from a file path given on the command line; nothing in this repo should
# hold one, and magpie's own store lives in ~/.config/magpie, outside the tree.
*.json.backup*
plugin-auth*.json
logins*.json
cred*.json
*.info
.env
.env.*
!.env.example
